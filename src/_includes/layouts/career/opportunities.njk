                            <path d="M29.4397 7.85123C29.2892 7.85123 29.1386 7.85123 28.988 7.85123C28.7433 7.85123 28.5645 7.74778 28.5645 7.48446C28.5645 7.23054 28.7433 7.13649 28.988 7.11769C29.6186 7.06126 30.2397 6.98602 30.8609 6.91079C31.0586 6.88258 31.2468 6.82615 31.435 6.76032C31.6892 6.67568 31.8962 6.73211 31.9715 6.98603C32.0562 7.24935 31.8868 7.41863 31.6421 7.46565C30.9174 7.62552 30.1833 7.76659 29.4492 7.91706C29.4492 7.88885 29.4492 7.87004 29.4397 7.85123Z" fill="#F26E65"/>
                            <path d="M13.2795 16.7664C13.3736 16.6254 13.4395 16.4843 13.5336 16.3903C15.7925 14.152 18.1736 12.0454 20.6301 10.0141C21.223 9.52505 21.8819 9.48743 22.4372 9.89182C22.9548 10.268 23.1525 10.9451 22.8983 11.5188C22.8136 11.7163 22.6725 11.9044 22.5125 12.0548C19.4913 14.7821 16.4607 17.5 13.4301 20.2178C13.0442 20.5658 12.9595 20.5752 12.5736 20.2084C11.4442 19.1269 10.3242 18.0548 9.21364 16.9545C8.77128 16.5125 8.63952 15.9577 8.85599 15.3652C9.06305 14.7915 9.47716 14.4341 10.0795 14.3213C10.663 14.2178 11.1336 14.4341 11.5289 14.8667C12.0842 15.478 12.6395 16.0799 13.2795 16.7664Z" fill="#F26E65"/>
                            </svg>
                             <p>{{ desc.careerDescriptionItem }}</p></li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
