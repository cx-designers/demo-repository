<section class="overflow-hidden position-relative career-area">
    <div class="container">
        <div class="row">
            <div class="col-full">
                <div class="heading-main-sec">
                    <h3><span>{{ careerSubtitle }}</span></h3>
                    <h4>{{ careerTitle }}</h4>
                </div>
            </div>
        </div>

        <div class="career-area-block">
            {% for step in careerBoxList %}
            <div class="career-area-block-wrap">
                <!-- FAQ Top Area -->
                <div class="career-area-block-top d-flex flex-wrap">
                    <div class="cx-icon">
                        <svg width="55" height="40" viewBox="0 0 55 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M55 27.4607C54.797 32.4359 53.9852 35.8189 50.738 38.008C48.0996 39.998 43.4317 39.998 35.3137 39.998H19.6863C11.3653 39.998 6.90037 39.998 4.26199 38.008C0 35.0229 0 29.8488 0 21.6896V18.3065C0 10.1473 0.202952 4.97317 4.26199 1.9881C6.90037 -0.00195312 11.5683 -0.00195312 19.6863 -0.00195312H35.3137C43.6347 -0.00195312 48.0996 -0.00195312 50.738 1.9881C53.7823 4.17715 54.5941 7.36123 55 12.1374H42.6199C42.6199 9.55029 36.9373 8.95327 31.2546 8.95327H23.9483C18.2657 8.95327 15.0184 9.15228 13.3948 10.5453C11.7712 11.9383 11.5683 14.3264 11.3653 18.7045V21.4906C11.3653 25.8687 11.7712 28.2568 13.3948 29.6498C15.0184 31.0428 18.2657 31.2418 23.9483 31.2418H31.2546C36.9373 31.2418 42.8229 30.6448 42.8229 27.4607H55Z" fill="white"/>
                        </svg>
                    </div>
                    <div class="career-info d-flex justify-content-center flex-column">
                        <p class="text-white card-title at-title">{{ step.careerJobTitle }}</p>
                        <div class="d-flex other-info">
                            <p class="text-white mb-0">Experience: <span class="fw-normal">{{ step.careerExp }}</span></p>
                            <p class="text-white mb-0">No. of Openings: <span class="fw-normal">{{ step.careerOpenings }}</span></p>
                            <p class="text-white mb-0">Qualification: <span class="fw-normal">{{ step.careerQualification }}</span></p>
                        </div>
                    </div>
                    <div class="button-wraaper d-flex align-items-center me-0 ms-auto">
                        <a href="javascript:;" class="primary-btn" aria-label="Apply now">
                            <span class="glow"></span>
                            <span class="stock"></span>
                            <span class="btn-text">Apply Now</span>
                        </a>
                    </div>
                </div>
                <!-- FAQ Description Area -->
                <div class="card-text text-white mb-0 at-tab">
                    <ul>
                        {% for desc in step.careerDescriptionList %}
                        <li class="d-flex align-items-center">
