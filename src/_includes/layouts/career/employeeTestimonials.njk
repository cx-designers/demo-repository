<section class="emp-testimonial-sec">
  <img src="../../assets/img/dots-bg.webp" alt="dots-bg-img" class="cust-bg">
  <div class="container">
    <div class="row">
      <div class="col-full">
          <div class="heading-main-sec">
              <h3><span>{{ empTestimonialSubTitle }}</span></h3>
              <h4>{{ empTestimonialTitle }}</h4>
          </div>
      </div>
    </div>
    <div class="row">
      
      <div class="col-full emp-tab-wrapper">
        <!-- Tab Content -->
        <div class="emp-tab-content" id="emp-testimonials-tabContent">
          {% for testimonial in empTestimonials %}
          <div class="tab-pane fade {% if testimonial.is_active %}show active{% endif %}" 
               id="{{ testimonial['emp-id'] }}" 
               role="tabpanel" 
               aria-labelledby="{{ testimonial['emp-aria-labelledby'] }}">
            {{ testimonial.content }}
          </div>
          {% endfor %}
        </div>
      
        <!-- Tab Navigation -->
        <nav>
          <div class="nav nav-tabs" id="nav-tab" role="tablist">
            {% for testimonial in empTestimonials %}
            <button class="nav-link {% if testimonial.is_active %}active{% endif %}" 
                    id="{{ testimonial['tab-id'] }}" 
                    data-bs-toggle="tab" 
                    data-bs-target="{{ testimonial['data-bs-target'] }}" 
                    type="button" 
                    role="tab" 
                    aria-controls="{{ testimonial['aria-controls'] }}" 
                    aria-selected="{% if testimonial.is_active %}true{% else %}false{% endif %}">
              <div class="emp-wrapper">
                <img src="{{ testimonial.img }}" alt="{{ testimonial.name }}">
              </div>
              <span class="emp-name">{{ testimonial.name }}</span>
            </button>
            {% endfor %}
          </div>
        </nav>
      </div>
      
      
    </div>
  </div>
</section>
