{% if featuresSecSubTitle or featuresSecTitle or featuresBoxList %}
  <div class="features-main-sec {{ featureSecWhiteBg }}">
    <div class="container">
      <div class="row">
        <div class="col-full">
          <div class="heading-main-sec">
            {% if featuresSecSubTitle %}
              <h3><span>{{ featuresSecSubTitle }}</span></h3>
            {% endif %}
            {% if featuresSecTitle %}
              <h4>{{ featuresSecTitle }}</h4>
            {% endif %}
          </div>
        </div>
      </div>
      <div class="row cust-row">
        {% if featuresBoxList and featuresBoxList | length > 0 %}
          {% for feature in featuresBoxList | batch(2) %}
            <div class="cust-column">
              {% for item in feature %}
                <div class="col-md-4">
                  {% if item.title %}
                    <h4 class="cust-inner-title text-white">{{ item.title }}</h4>
                  {% endif %}
                  {% if item.description %}
                    <p>{{ item.description }}</p>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}
