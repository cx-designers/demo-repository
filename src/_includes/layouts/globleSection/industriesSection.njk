{% if (industriesSubTitle and industriesSubTitle | trim != "") 
    or (industriesTitle and industriesTitle | trim != "") 
    or (industriesTitlePart and industriesTitlePart | trim != "") 
    or (industriesData and industriesData | length > 0) 
    or (industries.industriesSubTitle and industries.industriesSubTitle | trim != "") 
    or (industries.industriesTitle and industries.industriesTitle | trim != "") 
    or (industries.industriesTitlePart and industries.industriesTitlePart | trim != "") 
    or (industries.industriesData and industries.industriesData | length > 0) %}

<div class="industries-section">
  {% if (industriesShapeImg and industriesShapeImg | trim != "") 
      or (industries.industriesShapeImg and industries.industriesShapeImg | trim != "") %}
  <div class="industries-shap">
    <div class="image-sec">
      <img src="{{ industriesShapeImg or industries.industriesShapeImg }}" 
           alt="{{ industriesShapeImgAlt or industries.industriesShapeImgAlt or '' }}">
    </div>
  </div>
  {% endif %}

  <div class="container">
    <div class="row">
      <div class="col-full">
        <div class="heading-main-sec d-flex flex-column">
          {% if industriesTitle or industries.industriesTitle %}
            <h2 class="order-1 seo-title">{{ industriesTitle or industries.industriesTitle }}
              {% if industriesTitlePart or industries.industriesTitlePart %}
                <span>{{ industriesTitlePart or industries.industriesTitlePart }}</span>
              {% endif %}
            </h2>
          {% endif %}
          {% if industriesSubTitle or industries.industriesSubTitle %}
            <h3 class="order-0"><span>{{ industriesSubTitle or industries.industriesSubTitle }}</span></h3>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% if industriesData or industries.industriesData %}
  <div class="row">
    <div class="col-full">
      <div class="product-slider">
        <div class="slider">
          {% for item in industriesData or industries.industriesData %}
            {% if item.img or item.title %}
            <div class="slider-item">
              <div class="industries-item">
                {% if item.img %}
                  <div class="image-sec">
                    <img src="{{ item.img }}" alt="{{ item.alt or '' }}">
                  </div>
                {% endif %}
                {% if item.title %}
                  <div class="industries-title">
                    <p>{{ item.title }}</p>
                  </div>
                {% endif %}
              </div>
            </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
  {% endif %}
  <div class="industries-slider-small">
    <div class="container">
    {% if industriesData or industries.industriesData %}
      <div class="row">
        <div class="col-full">
          <div class="product-industries-slider swiper">
            <div class="cust-slider swiper-wrapper">
              {% for item in industriesData or industries.industriesData %}
                {% if item.img or item.title %}
                <div class="cust-slider-item swiper-slide">
                  <div class="industries-item">
                    {% if item.img %}
                      <div class="image-sec">
                        <img src="{{ item.img }}" alt="{{ item.alt or '' }}">
                      </div>
                    {% endif %}
                    {% if item.title %}
                      <div class="industries-title">
                        <p>{{ item.title }}</p>
                      </div>
                    {% endif %}
                  </div>
                </div>
                {% endif %}
              {% endfor %}
            </div>
              <!-- Optional navigation -->
            <div class="swiper-pagination"></div>
          </div>
        </div>
      </div>
    {% endif %}
    </div>
  </div>
</div>
{% endif %}
