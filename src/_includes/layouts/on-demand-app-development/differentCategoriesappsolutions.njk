<section class="different-categories">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="heading-main-sec text-start">
                    <h2>{{ differentcategoriesSubtitle or differentIndustries.differentcategoriesSubtitle }}</h2>
                    <h3>{{ differentcategoriesTitle or differentIndustries.differentcategoriesTitle }}</h3>
                </div>
            </div>

            {% for category in categories or differentIndustries.categories %}
                <div class="col-lg-3 col-md-6">
                    <div class="different-item">
                        <img src="{{ category.image }}" alt="{{ category.title }}" class="img-fluid">
                        <a href="{{ category.catLink }}" class="different-cat-link"></a>
                        <div class="different-content">
                            <h3>{{ category.title }}</h3>
                            <p>{{ category.description }}</p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
