<section class="blog-post-sec">
  <div class="container">
    <div class="row">
      <div class="col-full">
        <div class="heading-main-sec">
          <h3><span>{{ blogPostSubTitle }}</span></h3>
          <h4>{{ blogPostMainTitle }}</h4>
        </div>
      </div>
    </div>
  </div>
  <div class="swiper myblog-post">
    <div class="swiper-wrapper">
      {% for slide in blogpostSlides %}
      <div class="swiper-slide">
        <div class="blog-post-slide">
          <div class="blog-img">
            <img src="{{ slide.blogSliderImg }}" alt="{{ slide.blogSliderImgAlt }}">
          </div>
          <div class="bottom-text">
            <p>{{ slide.blogSliderTitle }}</p>
            <h3>{{ slide.blogSliderContent }}</h3>
          </div>
        </div>
        <div class="blog-swiper-bottom-arrow">
          <a href="javascript:void(0)" aria-label="{{ slide.blogSliderArrowAriaLabel }}"> <img
              src="{{ slide.blogSliderArrowImg }}" alt="{{ slide.blogSliderArrowImgAlt }}"></a>
        </div>
        <span class="btn-text"></span>
      </div>
      {% endfor %}
    </div>
    
    <div class="swiper-button-prev-main">
      <span class="glow"></span>
      <div class="swiper-button-prev"></div>
      <span class="btn-text">
      </span>
    </div>
    <div class="swiper-button-next-main">
      <span class="glow"></span>
      <div class="swiper-button-next"></div>
      <span class="btn-text">
      </span>
    </div>
    <div class="autoplay-progress-bar">
      <div class="progress"></div>
    </div>
  </div>
</section>