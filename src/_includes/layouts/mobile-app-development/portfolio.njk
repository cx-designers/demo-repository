{% if (portfolioSubTitle and portfolioSubTitle | trim != "") 
    or (portfolioMainTitle and portfolioMainTitle | trim != "") 
    or (portfolioSlides and portfolioSlides | length > 0) 
    or (portfolio.portfolioSubTitle and portfolio.portfolioSubTitle | trim != "") 
    or (portfolio.portfolioMainTitle and portfolio.portfolioMainTitle | trim != "") 
    or (portfolio.portfolioSlides and portfolio.portfolioSlides | length > 0) %}

<section class="portfolio-main-sec">
    <div class="container">
        <div class="row">
            <div class="col-full">
                <div class="heading-main-sec">
                    {% if portfolioSubTitle and portfolioSubTitle | trim != "" %}
                        <h3>{{ portfolioSubTitle }}</h3>
                    {% elseif portfolio.portfolioSubTitle and portfolio.portfolioSubTitle | trim != "" %}
                        <h3>{{ portfolio.portfolioSubTitle }}</h3>
                    {% endif %}

                    {% if portfolioMainTitle and portfolioMainTitle | trim != "" %}
                        <h4>{{ portfolioMainTitle }}</h4>
                    {% elseif portfolio.portfolioMainTitle and portfolio.portfolioMainTitle | trim != "" %}
                        <h4>{{ portfolio.portfolioMainTitle }}</h4>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="portfolio-slider-main">
            <div class="swiper portfolio-slider">
                <div class="swiper-wrapper">
                    {% set slides = portfolioSlides if portfolioSlides else portfolio.portfolioSlides %}
                    {% for slide in slides %}
                    <div class="swiper-slide">
                        <div class="portfolio-wrapper">
                            <div class="image-sec">
                                <img src="{{ slide.sliderImg }}" alt="{{ slide.sliderImgAlt }}">
                            </div>

                            <div class="content-sec">
                                <div class="top-content">
                                    <h3>{{ slide.content1 }}</h3>
                                    <h4>{{ slide.content2 }}</h4>
                                    <h5>{{ slide.content3 }}</h5>
                                    <p>{{ slide.content4 }}</p>
                                </div>

                                <div class="bottom-content">
                                    <h3>{{ slide.content5 }}</h3>
                                    <p>{{ slide.content6 }}</p>

                                    <a href="javascript:;" class="primary-btn" aria-label="{{ slide.buttonAreaLabel }}">
                                        <span class="glow"></span>
                                        <span class="stock"></span>
                                        <span class="btn-text">{{ slide.buttonText }}</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                <div class="swiper-pagination"></div>
            </div>

            <div thumbsSlider="" class="swiper portfolio-thumb">
                <div class="swiper-wrapper">
                    {% for slide in slides %}
                    <div class="swiper-slide">
                        <div class="thumb-image">
                            <div class="thumb-img-inner">
                                <img src="{{ slide.thumbImg }}" alt="{{ slide.thumbImgAlt }}">
                            </div>
                        </div>

                        <div class="main-title">
                            <h3>{{ slide.thumbContent }}</h3>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>

{% endif %}
