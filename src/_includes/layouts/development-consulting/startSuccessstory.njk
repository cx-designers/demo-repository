<section class="success-story">
    <img src="../../../assets/img/success-story-ba.webp" alt="" class="img-fluid">
    <div class="container">
        <div class="row align-items-end">
            <div class="col-md-6">
                <div class="heading-main-sec text-start">
                    <h3>{{successstorySubtitle}}</h3>
                    <h4>{{successstoryTitle}}</h4>
                    {% for successstory in successstory %}
                    <p>{{ successstory.description }}</p>
                    {% endfor %}
                </div>
            </div>
            <div class="col-md-6">
                <div class="success-story-img">
                    <img src="../../../assets/img/woman-with-raised.webp" alt="" >                
                </div>
            </div>
        </div>
    </div>
</section>